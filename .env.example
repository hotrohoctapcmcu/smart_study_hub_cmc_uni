DB_PATH=./data/unistudy.db
API_PORT=3001
JWT_SECRET=replace_with_a_long_random_secret
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
NODE_ENV=development

# AI: dùng Gemini web chưa đăng nhập; tự mở phiên khách, không cần key/cookie đăng nhập.
GEMINI_TIMEOUT_MS=45000

# Tóm tắt học liệu: AI chỉ chạy khi người dùng bấm; các môn dùng hàng đợi FIFO.
# PART/SUMMARY là mục tiêu trình bày; STORED là trần lưu nội dung hợp lệ.
# LEARNING_AI_INPUT_CHARS=60000
# LEARNING_AI_CONCURRENCY=4
# LEARNING_AI_CHUNK_CHARS=12000
# LEARNING_AI_PART_CHARS=4000
# LEARNING_AI_SUMMARY_CHARS=8000
# LEARNING_AI_STORED_CHARS=120000
# LEARNING_AI_TIMEOUT_MS=120000

# Sprint 2: mặc định lưu tệp cạnh DB_PATH, trong thư mục documents/.
# DOCUMENTS_PATH=./data/documents
# Bản Electron đăng nhập bằng nút Kết nối Outlook, không cần token cấu hình.
# Chỉ dùng cho headless: token Microsoft Graph được cấp quyền Mail.Read.
# OUTLOOK_ACCESS_TOKEN=
