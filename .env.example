DB_PATH=./data/unistudy.db
API_PORT=3001
JWT_SECRET=replace_with_a_long_random_secret
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
NODE_ENV=development

# EDUX (tùy chọn) — mặc định trỏ edux.cmcu.edu.vn
# EDUX_ORIGIN=https://edux.cmcu.edu.vn
# EDUX_API_BASE=https://edux.cmcu.edu.vn/api
# Thời gian sống của phiên EDUX trong RAM (mặc định 24 giờ)
# EDUX_SESSION_TTL_MS=86400000
# Timeout mỗi lần đăng nhập EDUX (mặc định 25 giây)
# EDUX_TIMEOUT_MS=25000

# Trợ lý AI (Gemini) — KHÔNG bắt buộc cấu hình: mở app là chat được ngay bằng
# phiên khách. Các biến dưới đây chỉ để dùng phiên đăng nhập riêng (nếu có).
# Cookie phiên Gemini, dán nguyên chuỗi cookie hoặc nội dung dạng "name<TAB>value".
# Cookie hết hạn sẽ tự động được thay bằng phiên khách, không làm khoá khung chat.
# GEMINI_COOKIES=
# Thư mục lưu phiên Gemini (mặc định ./data)
# GEMINI_SESSION_DIR=./data
# Timeout mỗi lần gọi Gemini (mặc định 45 giây)
# GEMINI_TIMEOUT_MS=45000
